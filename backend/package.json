{
  "name": "route-optimizer-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "ingest:osm": "tsx scripts/ingest-osm.ts",
    "benchmark:pathfinding": "tsx scripts/benchmark-pathfinding.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/pathfinding.test.ts tests/route-optimizer.test.ts --coverage",
    "test:integration": "vitest run tests/nearest-node.test.ts tests/routes-api.test.ts tests/response-cache.test.ts tests/async-jobs.test.ts tests/job-websocket.test.ts",
    "load:test": "tsx scripts/load-test.ts",
    "lint": "eslint \"{src,scripts,tests}/**/*.ts\" vitest.config.ts",
    "format": "prettier --write \"{src,scripts,tests}/**/*.ts\" vitest.config.ts",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.ts\" vitest.config.ts"
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^6.0.0",
    "osm-pbf-parser": "^2.3.0",
    "pg": "^8.22.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/autocannon": "^7.12.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "autocannon": "^8.0.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0",
    "vitest": "4.1.10"
  }
}
